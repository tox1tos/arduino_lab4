
const byte ROW_PINS[4] = {8, 9, 10, 11};
const byte COL_PINS[4] = {5, 2, 3, 4};

const char KEYS[4][4] = {
  {'A', 'D', 'C', 'B'},
  {'3', '#', '9', '6'},
  {'2', '0', '8', '5'},
  {'1', '*', '7', '4'}
};

volatile bool buttonPressed = false;

char lastKey = '\0';

unsigned long lastDebounceTime = 0;
const unsigned long debounceDelay = 30;

bool checkingButton = false;

ISR(PCINT0_vect) { 
  buttonPressed = true;
}

char readKeypad() { 
  noInterrupts();
  PCICR &= ~(1 << PCIE0);
  interrupts();

  for (byte col = 0; col < 4; col++) {
    pinMode(COL_PINS[col], INPUT);
  }

  char key = '\0';

  for (byte col = 0; col < 4; col++) {
    digitalWrite(COL_PINS[col], LOW);
    pinMode(COL_PINS[col], OUTPUT);
    delayMicroseconds(50);
    
    for (byte row = 0; row < 4; row++) {
      if (digitalRead(ROW_PINS[row]) == LOW) {
        key = KEYS[row][col];
        break;
      }
    }

    pinMode(COL_PINS[col], INPUT);
    if (key != '\0') {
      break;
    }
  }


  for (byte col = 0; col < 4; col++) {
    digitalWrite(COL_PINS[col], LOW);
    pinMode(COL_PINS[col], OUTPUT);
  }

  noInterrupts();
  PCIFR = (1 << PCIF0);
  PCICR |= (1 << PCIE0);
  interrupts();
  return key;
}


void setup() {
  Serial.begin(9600);
  for (byte row = 0; row < 4; row++) {
    pinMode(ROW_PINS[row], INPUT_PULLUP);
  }

  for (byte col = 0; col < 4; col++) {
    digitalWrite(COL_PINS[col], LOW);
    pinMode(COL_PINS[col], OUTPUT);
  }

  noInterrupts();

  PCMSK0 |= (1 << PCINT0);
  PCMSK0 |= (1 << PCINT1);
  PCMSK0 |= (1 << PCINT2);
  PCMSK0 |= (1 << PCINT3);
  PCIFR = (1 << PCIF0);
  PCICR |= (1 << PCIE0);
  interrupts();
  Serial.println("старт");
}


void loop() {

  if (buttonPressed) { 
    noInterrupts();
    buttonPressed = false;
    interrupts();
    lastDebounceTime = millis();
    checkingButton = true;
  }

  if (checkingButton &&  
      millis() - lastDebounceTime >= debounceDelay) {
    checkingButton = false;
    char currentKey = readKeypad();
    if (currentKey != lastKey) {
      if (currentKey != '\0') {
        Serial.print("нажата кнопка: ");
        Serial.println(currentKey);
      }

      lastKey = currentKey;
    }
  }
}
